# Replace 192.0.2.25 with the connector's fixed, trusted source address.
# Put this inside the relevant Apache VirtualHost configuration and reload Apache.
<LocationMatch "^/ics_finalproject/ad_sync_api\.php$">
    Require ip 192.0.2.25
</LocationMatch>

# Configure TLS for that same VirtualHost. Do not expose the endpoint over plain HTTP.

# When TLS terminates at a reverse proxy, keep PHP behind that proxy and configure the
# immediate proxy address in AD_SYNC_TRUSTED_PROXY_IPS (comma-separated IP literals).
# Only that configured peer may supply X-Forwarded-Proto: https; do not set a global
# SetEnvIf rule that trusts the header from arbitrary clients.
